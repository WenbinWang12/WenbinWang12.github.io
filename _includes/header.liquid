<header>
  {% assign current_lang = page.lang | default: site.lang | default: 'en' %}
  {% assign page_translation_key = page.translation_key | default: '' %}
  {% assign home_url = '/' %}
  {% if current_lang == 'zh' %}
    {% assign about_title = '关于' %}
    {% assign language_toggle_label = '中' %}
  {% else %}
    {% assign about_title = 'About' %}
    {% assign language_toggle_label = 'EN' %}
  {% endif %}
  {% assign english_switch_url = '/' %}
  {% assign chinese_switch_url = '/zh/' %}

  {% for candidate in site.pages %}
    {% assign candidate_lang = candidate.lang | default: site.lang | default: 'en' %}
    {% if candidate.translation_key == 'home' and candidate_lang == current_lang %}
      {% assign home_url = candidate.url %}
      {% assign about_title = candidate.title %}
    {% endif %}
    {% if page_translation_key != blank and candidate.translation_key == page_translation_key %}
      {% if candidate_lang == 'en' %}
        {% assign english_switch_url = candidate.url %}
      {% elsif candidate_lang == 'zh' %}
        {% assign chinese_switch_url = candidate.url %}
      {% endif %}
    {% endif %}
  {% endfor %}

  {% if current_lang == 'zh' %}
    {% assign language_switch_url = english_switch_url %}
    {% assign language_toggle_title = '切换到英文' %}
  {% else %}
    {% assign language_switch_url = chinese_switch_url %}
    {% assign language_toggle_title = 'Switch to Chinese' %}
  {% endif %}

  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.translation_key != 'home' %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if site.title == 'blank' %}
            {% if site.first_name %}
              <span class="font-weight-bold">
                {{- site.first_name -}}
              </span>
            {% endif %}
            {% if site.middle_name %}
              {{- site.middle_name -}}
            {% endif %}
            {% if site.last_name %}
              {{- site.last_name -}}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}

      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <!-- About -->
          <li class="nav-item {% if page.translation_key == 'home' %}active{% endif %}">
            <a class="nav-link" href="{{ home_url | relative_url }}">
              {{- about_title }}
              {% if page.translation_key == 'home' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% assign p_lang = p.lang | default: site.lang | default: 'en' %}
            {% if p.nav and p.autogen == null and p_lang == current_lang and p.translation_key != 'home' %}
              {% if p.dropdown %}
                {% assign has_active_child = false %}
                {% for child in p.children %}
                  {% assign child_permalink = child.permalink | remove: 'index.html' %}
                  {% if child.translation_key == page.translation_key or page.url contains child_permalink %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.translation_key == p.translation_key or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- p.title }}
                    {% if page.translation_key == p.translation_key or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in p.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.translation_key == child.translation_key or page.url contains child.permalink %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = p.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.translation_key == p.translation_key or page.url contains parent_link %}active{% endif %}">
                  {%- if p.permalink contains '://' -%}
                    {%- assign url = p.permalink -%}
                  {%- elsif p.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = p.url -%}
                  {%- endif -%}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- p.title }}
                    {% if page.translation_key == p.translation_key or page.url contains p.url %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}

          <li class="toggle-container language-toggle-container">
            <a
              id="language-toggle"
              href="{{ language_switch_url | relative_url }}"
              title="{{ language_toggle_title }}"
              aria-label="{{ language_toggle_title }}"
            >
              <span class="language-toggle-label">{{ language_toggle_label }}</span>
            </a>
          </li>

          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
